# Copy to .env and fill in. .env is git-ignored.
GEMINI_API_KEY=            # Google AI Studio / Gemini API key
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j       # Triangulate only ever deletes its own labels in this database
GITHUB_TOKEN=              # optional; without it the GitHub API allows 60 requests/hour
