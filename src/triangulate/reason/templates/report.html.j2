<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>PR #{{ pr.number }} Risk Brief</title>
<style>
:root{--bg:#f6f7f9;--surface:#fff;--surface-2:#f1f3f6;--text:#1b1e24;--muted:#5a6272;--border:#e2e5ea;--accent:#3657d6;
--high:#b91c1c;--high-soft:#fee2e2;--med:#b45309;--med-soft:#fef3c7;--low:#15803d;--low-soft:#dcfce7;--q:#c2410c;--q-soft:#ffedd5;color-scheme:light}
@media (prefers-color-scheme: dark){:root:not([data-theme="light"]){--bg:#0f1115;--surface:#171a20;--surface-2:#1e222a;--text:#e7e9ee;--muted:#a1a8b6;
--border:#2a2f39;--accent:#8aa0ff;--high:#f87171;--high-soft:#3a1717;--med:#fbbf24;--med-soft:#352a0e;--low:#4ade80;--low-soft:#12301d;--q:#fb923c;--q-soft:#3a2312;color-scheme:dark}}
*{box-sizing:border-box} body{margin:0;background:var(--bg);color:var(--text);font:16px/1.6 ui-sans-serif,system-ui,-apple-system,"Segoe UI",Roboto,Arial,sans-serif}
.wrap{max-width:980px;margin:0 auto;padding:28px 16px 60px} a{color:var(--accent)}
.card{background:var(--surface);border:1px solid var(--border);border-radius:14px;padding:18px 20px;margin:14px 0}
h1{font-size:24px;line-height:1.25;margin:4px 0 6px} h2{font-size:19px;margin:30px 0 8px} h3{font-size:16px;margin:0 0 4px}
.muted{color:var(--muted)} .small{font-size:13.5px}
.badge{display:inline-block;font-weight:700;font-size:12px;padding:2px 10px;border-radius:999px;vertical-align:2px}
.High{background:var(--high-soft);color:var(--high)} .Medium{background:var(--med-soft);color:var(--med)} .Low{background:var(--low-soft);color:var(--low)}
.LOSES_COVERAGE{background:var(--high-soft);color:var(--high)} .AT_RISK{background:var(--med-soft);color:var(--med)} .WEAK_SIGNAL{background:var(--surface-2);color:var(--muted)}
.stats{display:flex;flex-wrap:wrap;gap:8px;margin-top:10px} .stat{background:var(--surface-2);border-radius:10px;padding:6px 12px;font-size:14px}
.stat b{font-size:17px;margin-right:4px}
.item{border:1px solid var(--border);border-radius:12px;padding:14px 16px;margin:10px 0;background:var(--surface)}
ol.steps{margin:8px 0 6px;padding-left:22px} ol.steps li{margin:2px 0}
.shot{position:relative;margin-top:10px;border:1px solid var(--border);border-radius:10px;overflow:hidden;max-width:720px}
.shot img{display:block;width:100%;height:auto} .box{position:absolute;border:3px solid #e11d48;border-radius:6px;box-shadow:0 0 0 2000px rgba(0,0,0,.18)}
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:12px}
.q{background:var(--q-soft);border:1px solid color-mix(in srgb,var(--q) 30%,transparent);border-radius:12px;padding:12px 14px;margin:8px 0}
blockquote{margin:6px 0;padding:4px 12px;border-left:3px solid var(--border);color:var(--muted);font-size:14.5px}
details{margin:8px 0} summary{cursor:pointer;color:var(--muted)} table{border-collapse:collapse;width:100%;font-size:13.5px}
td,th{border-bottom:1px solid var(--border);padding:6px 8px;text-align:left;vertical-align:top} th{color:var(--muted);font-weight:600}
.tw{overflow-x:auto} code{font-size:12.5px;background:var(--surface-2);padding:1px 5px;border-radius:5px}
.legend span{margin-right:10px}
</style>
</head>
<body>
<div class="wrap">
  <div class="muted small">Risk brief · generated by Triangulate · live app v{{ manifest.app.version }} · crawl {{ manifest.run_id }}</div>
  <h1>PR #{{ pr.number }}: {{ pr.title }}</h1>
  <div class="card">
    <div><span class="badge {{ summary.overall_risk }}">{{ summary.overall_risk }} risk</span>
      <a class="small" href="{{ pr.html_url }}">view on GitHub</a> · <span class="small muted">{{ pr.state }}{% if pr.merged %}, merged{% endif %} · by {{ pr.user }}</span></div>
    <p style="font-size:17px;margin:12px 0 6px"><b>{{ text.headline }}</b></p>
    <p class="muted" style="margin:0">{{ text.what_changed }}</p>
    <div class="stats">
      <div class="stat"><b>{{ retest|length }}</b>user flows to retest</div>
      <div class="stat"><b>{{ screens|length }}</b>screens affected</div>
      <div class="stat"><b>{{ requirements|length }}</b>requirements at risk</div>
      <div class="stat"><b>{{ summary.requirements_losing_coverage }}</b>losing coverage</div>
      <div class="stat"><b>{{ text.questions|length }}</b>questions for you</div>
    </div>
  </div>

  <h2>Retest these first</h2>
  {% if not retest %}<p class="muted">No recorded user flow passes through the changed parts of the app.</p>{% endif %}
  {% for r in retest %}
  <div class="item">
    <h3><span class="badge {{ r.flow.band }}">{{ r.flow.band }}</span> {{ r.flow.name }}</h3>
    <div class="small muted">{{ r.why }}</div>
    <ol class="steps">
      <li>Open <b>{{ r.flow.start_label }}</b></li>
      {% for s in r.flow.steps %}<li>Click <b>{{ s }}</b></li>{% endfor %}
      <li>Check <b>{{ r.target_label }}</b> works as expected</li>
    </ol>
    {% if r.shot %}<div class="shot"><img src="{{ r.shot.src }}" alt="Screen: {{ r.shot.label }}">
      {% for b in r.shot.boxes %}<div class="box" style="left:{{ b[0] }}%;top:{{ b[1] }}%;width:{{ b[2] }}%;height:{{ b[3] }}%"></div>{% endfor %}</div>
      <div class="small muted">{{ r.shot.label }} - outlined: what this change can affect</div>{% endif %}
  </div>
  {% endfor %}

  <h2>Screens affected</h2>
  <div class="grid">
  {% for s in screens %}
    <div class="item"><span class="badge {{ s.band }}">{{ s.band }}</span> <b>{{ s.label }}</b>
      <div class="small muted">{{ s.note }}</div>
      <div class="small">At risk: {{ s.controls }}</div></div>
  {% endfor %}
  </div>
  {% if not screens %}<p class="muted">No screen we visited shows the changed code with medium or high confidence.</p>{% endif %}
  {% if low_screens %}<details><summary>{{ low_screens|length }} more screen(s) with a weak signal</summary>
    <ul class="small">{% for s in low_screens %}<li>{{ s.label }} <span class="muted">({{ s.controls }})</span></li>{% endfor %}</ul></details>{% endif %}

  <h2>Product requirements</h2>
  {% for q in requirements %}
  <div class="item"><span class="badge {{ q.status }}">{{ q.status_label }}</span> <b>{{ q.statement }}</b>
    <div class="small muted">{{ q.note }}</div>
    <blockquote>“{{ q.quote }}” - <a href="{{ q.url }}">{{ q.feature }} docs</a></blockquote></div>
  {% endfor %}
  {% if not requirements %}<p class="muted">No documented requirement loses coverage or is at risk.</p>{% endif %}
  {% if weak_requirements %}<details><summary>{{ weak_requirements|length }} requirement(s) with a weak signal</summary>
    <ul class="small">{% for q in weak_requirements %}<li>{{ q.statement }} <span class="muted">- {{ q.note }}</span></li>{% endfor %}</ul></details>{% endif %}
  {% if gaps %}
  <div class="card small"><b>Also touched:</b> code behind documented features we could not verify on screen:
    <ul>{% for gp in gaps %}<li>{{ gp.statement }} <span class="muted">({{ gp.kind_label }})</span></li>{% endfor %}</ul></div>
  {% endif %}

  <h2>Needs a human</h2>
  {% for q in text.questions %}<div class="q">{{ q.question }}</div>{% endfor %}
  {% if not text.questions %}<p class="muted">Nothing open.</p>{% endif %}
  {% if unmapped %}<details open><summary>Parts of this change we could not connect to a screen ({{ unmapped|length }})</summary>
    <ul class="small">{% for u in unmapped %}<li>{{ u.why }}</li>{% endfor %}</ul></details>{% endif %}

  <h2>How sure are we</h2>
  <div class="card small legend">
    <span><span class="badge High">High</span> retest this</span><span><span class="badge Medium">Medium</span> worth a check</span><span><span class="badge Low">Low</span> weak signal</span>
    <p>Each rating is the strength of the single best chain of evidence from the changed code to the control: how directly
    the change touches it, times how sure we are that the control is drawn by that code (measured on hand-checked samples).
    Requirement links were judged by an AI model against the live screens and verified by code; open doubts are listed above.</p>
  </div>

  <details><summary>Appendix for engineers: evidence chains and changed files</summary>
    <div class="tw"><table><tr><th>Control</th><th>Risk</th><th>Evidence chain</th></tr>
    {% for e in elements %}<tr><td>{{ e.label }} <span class="muted">({{ e.route }})</span></td><td>{{ '%.2f'|format(e.risk) }}</td><td>{{ e.chain|join(' → ') }}</td></tr>{% endfor %}
    </table></div>
    <div class="tw"><table><tr><th>File</th><th>Change</th><th>Drift vs crawled release</th></tr>
    {% for c in changes %}<tr><td><code>{{ c.file }}</code></td><td>{{ c.kinds|join(', ') }}</td><td>{{ 'yes' if c.drift else 'no' }}</td></tr>{% endfor %}
    {% for c in outside %}<tr><td><code>{{ c.file }}</code></td><td colspan="2">{{ c.why }}</td></tr>{% endfor %}
    </table></div>
  </details>
</div>
</body>
</html>
